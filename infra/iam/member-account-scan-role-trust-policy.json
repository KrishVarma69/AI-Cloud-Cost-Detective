{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustHubTaskRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::HUB_ACCOUNT_ID:role/CostDetectiveTaskRole"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "sts:ExternalId": "REPLACE_WITH_A_RANDOM_EXTERNAL_ID" }
      }
    }
  ]
}
