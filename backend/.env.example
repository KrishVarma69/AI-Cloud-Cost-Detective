# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── Database (Amazon RDS for PostgreSQL) ──────────────────────────────────────
# RDS enforces TLS — keep sslmode=require unless you know otherwise.
DATABASE_URL=postgresql://user:password@your-db.abc123xyz.us-east-1.rds.amazonaws.com:5432/costdetective?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── AWS ──────────────────────────────────────────────────────────────────────
# The backend shells out to the AWS CLI, which uses the standard credential
# chain. Set a profile, or leave AWS_PROFILE unset and rely on
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / an instance role.
# AWS_PROFILE=default
# Default region only matters for Cost Explorer (a global service pinned to us-east-1).
AWS_REGION=us-east-1
