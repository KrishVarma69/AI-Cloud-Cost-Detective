# ── App environment ──────────────────────────────────────────────────────────
# "development" or "production". With APP_ENV=production the app refuses to start
# if JWT_SECRET is still the default / too short, or FRONTEND_ORIGIN points at
# localhost.
APP_ENV=development

# ── LLM provider ─────────────────────────────────────────────────────────────
# "openai" (default) or "bedrock". Bedrock keeps the scan payload inside your
# AWS account/region and is recommended for organisation-wide use.
LLM_PROVIDER=openai

# -- OpenAI  (used when LLM_PROVIDER=openai) --
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# -- Amazon Bedrock  (used when LLM_PROVIDER=bedrock) --
# Uses the same AWS credential chain as the scanner. Enable model access in the
# Bedrock console first, then set the id to a model your account has enabled.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# ── Database (Amazon RDS for PostgreSQL) ─────────────────────────────────────
# RDS enforces TLS — keep sslmode=require unless you know otherwise.
DATABASE_URL=postgresql://user:password@your-db.abc123xyz.us-east-1.rds.amazonaws.com:5432/costdetective?sslmode=require

# ── Auth / signup ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=7
# Set to false to disable self-service signup (provision users manually).
ALLOW_SIGNUP=true
# Optional comma-separated email-domain allowlist for signup, e.g. "acme.com,acme.co.uk".
SIGNUP_ALLOWED_DOMAINS=

# ── Rate limiting (per user, per backend process) ───────────────────────────
ANALYZE_RATE_LIMIT_PER_HOUR=20
ANALYZE_MAX_CONCURRENT_PER_USER=2

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:5173

# ── AWS ──────────────────────────────────────────────────────────────────────
# The backend shells out to the AWS CLI, which uses the standard credential
# chain. Set a profile, or leave AWS_PROFILE unset and rely on
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / an instance or task role.
# AWS_PROFILE=default
# Default region only matters for Cost Explorer (a global service pinned to us-east-1).
AWS_REGION=us-east-1

# ── Multi-account scanning (optional) ───────────────────────────────────────
# Accounts offered in the UI picker. Comma-separated "<id>" or "<id>:<label>".
# Leave empty to scan only the account the backend's own credentials resolve to.
#   SCAN_ACCOUNTS=111122223333:Production,444455556666:Sandbox
SCAN_ACCOUNTS=
# Role assumed in each target account (must trust the backend's role / principal).
CROSS_ACCOUNT_ROLE_NAME=CostDetectiveScanRole
# External id required by that role's trust policy (recommended). Store as a secret.
CROSS_ACCOUNT_EXTERNAL_ID=
